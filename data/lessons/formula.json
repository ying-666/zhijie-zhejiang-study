    "problemTypes": [
      "root-problem"
    ],
    "foundation": "标准式是 $ax^2+bx+c=0$，其中 $a\\ne0$；判别式 $\\Delta=b^2-4ac$。",
    "principle": "两边乘 $4a$ 后加上 $b^2-4ac$，得到 $(2ax+b)^2=\\Delta$。根据右侧符号，方程有两个、一个或零个不同实根。",
    "approach": "先移项识别带符号的 $a,b,c$。只有根数任务时做到判别式即可。求根用 $x=(-b\\pm\\sqrt{\\Delta})/(2a)$。",
    "examples": [
      {
        "level": "入门",
        "prompt": "解 $x^2-2x-1=0$。",
        "solution": "$\\Delta=4+4=8$。代入公式得 $x=1\\pm\\sqrt2$。"
      },
      {
        "level": "进阶",
        "prompt": "判断 $2x^2-4x+3=0$ 有几个实根。",
        "solution": "$\\Delta=16-24=-8$，平方不可能等于负数，故无实根。"
      }
    ],
    "error": "把负的一次系数代入 $b^2$ 时漏括号。先单独列 $b$，再平方。",
    "standard": "能区分重根和两个不同实根，并正确化简求根公式。",
    "application": "函数与水平线的交点个数可转化为二次方程实根个数。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
