  "lesson": {
    "definition": "识别分母因式并把分式通至同一分母。",
    "prerequisites": [
      "factor",
      "cancel"
    ],
    "knowledge": [
      "domain",
      "distributive"
    ],
    "methods": [
      "denom-route"
    ],
    "problemTypes": [
      "algebra-simplify",
      "rational-problem"
    ],
    "foundation": "分数相加需使用同一个分母。多项式分母一般先分解，以各因式最高重数构造公分母。",
    "principle": "$\\frac{a}{b}=\\frac{ac}{bc}$ 要求 $b,c$ 非零。加减只发生在通分后的分子。",
    "approach": "分母是倍数时用较高次的分母；分母互不整除时用公因式的最小组合。减号应作用到后一个分子整体。",
    "examples": [
      {
        "level": "入门",
        "prompt": "$\\frac1x+\\frac1{x+1}$。",
        "solution": "限制 $x\\ne0,-1$，通分得 $\\frac{(x+1)+x}{x(x+1)}=\\frac{2x+1}{x(x+1)}$。"
      },
      {
        "level": "进阶",
        "prompt": "$\\frac{2}{x-1}-\\frac{x+2}{x^2-1}$。",
        "solution": "限制 $x\\ne\\pm1$，通分得 $\\frac{2(x+1)-(x+2)}{(x-1)(x+1)}=\\frac{x}{x^2-1}$。"
      }
    ],
    "error": "只给分母添因子，分子未同乘。把每一项的缺因式写在分子旁再展开。",
    "standard": "能说明公分母的选择，运算分子时保留括号，并列出原限制。",
    "application": "分式方程和函数差值化简中，通分把条件转化为整式关系。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
