  "lesson": {
    "definition": "将分式方程转为整式方程，并从候选根中剔除原式无定义的值。",
    "prerequisites": [
      "common-denom",
      "cancel"
    ],
    "knowledge": [
      "domain",
      "zeros"
    ],
    "methods": [
      "restrict",
      "denom-route"
    ],
    "problemTypes": [
      "rational-problem"
    ],
    "foundation": "同时乘原分母的公倍式前，明确它在哪些点非零。",
    "principle": "只有在允许域内，乘公分母可逆。整式方程如果有原分母零点作为根，只能视为候选。",
    "approach": "先定域，再去分母，然后求候选并验域；代回原式是额外的算术校验。",
    "examples": [
      {
        "level": "入门",
        "prompt": "解 $\\frac{x+1}{x}=3$。",
        "solution": "$x\\ne0$，去分母为 $x+1=3x$，得 $x=1/2$，满足定义域。"
      },
      {
        "level": "进阶",
        "prompt": "解 $\\frac{x+1}{x-2}=\\frac3{x-2}$。",
        "solution": "$x\\ne2$，去分母为 $x+1=3$，只得 $x=2$，排除后无解。"
      }
    ],
    "error": "化简后才找定义域，漏排被约去的零点。开头对原题的每一个分式检查。",
    "standard": "能列出候选根、排除非法值并在需要时报告空集。",
    "application": "行程或比值建模中还应核对现实约束，如速度正、时间正。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
