{
  "node": {
    "id": "nested-fraction",
    "subject": "math",
    "name": "复杂分式化简",
    "parent": "fraction",
    "definition": "区分复杂分式的内部分母与外层除数，逐层化简。"
  },
  "lesson": {
    "definition": "区分复杂分式的内部分母与外层除数，逐层化简。",
    "prerequisites": [
      "common-denom",
      "cancel"
    ],
    "knowledge": [
      "domain"
    ],
    "methods": [
      "restrict",
      "denom-route"
    ],
    "problemTypes": [
      "algebra-simplify",
      "rational-problem"
    ],
    "foundation": "分式线等同除号。内部分母必须非零，外层分母作为一个整体也必须非零。",
    "principle": "$\\frac{a/b}{c/d}=\\frac{ad}{bc}$，条件为 $b,d,c$ 都非零。外层除法要求 $c/d\\ne0$。",
    "approach": "上下两部分各通分，再乘以下部的倒数。上下同乘非零公分母可加速，但要先记录限制。",
    "examples": [
      {
        "level": "入门",
        "prompt": "$\\frac{1/x}{2/x}$ 化简。",
        "solution": "内部分母要求 $x\\ne0$，外层分母 $2/x$ 在该范围非零，商为 $\\frac12$。"
      },
      {
        "level": "进阶",
        "prompt": "$\\frac{1+1/x}{1-1/x}$ 化简。",
        "solution": "先要求 $x\\ne0$，又因 $1-1/x=0$ 对应 $x=1$，排除 1。上下同乘 $x$，得 $\\frac{x+1}{x-1}$。"
      }
    ],
    "error": "只看结果的分母，漏掉原式限制。把每条分式线对应的非零条件单独写出。",
    "standard": "能在三步内列全限制、执行倒数乘法、检查简式。",
    "application": "比值型函数变形中保留原有空点，后续零点和单调性才有正确区间。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
