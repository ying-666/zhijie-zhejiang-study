    "definition": "用分配律展开多项式，并按同类项合并。",
    "prerequisites": [],
    "knowledge": [
      "distributive"
    ],
    "methods": [
      "collect"
    ],
    "problemTypes": [
      "algebra-simplify"
    ],
    "foundation": "单项式乘积先乘系数，再按底数相同合并指数。同类项要有相同的字母和指数。",
    "principle": "每个因式中的每一项都必须与另一个因式的每一项相乘。对 $(a+b)(c+d)$，先分成 $a(c+d)+b(c+d)$，得到 $ac+ad+bc+bd$。",
    "approach": "结构匹配时用平方或平方差公式。结构相近但符号不确定时，逐项列乘积更稳妥。",
    "examples": [
      {
        "level": "入门",
        "prompt": "展开 $(x+2)(x-3)$。",
        "solution": "四项为 $x^2,-3x,2x,-6$，合并得 $x^2-x-6$。"
      },
      {
        "level": "进阶",
        "prompt": "化简 $(2x-1)^2-(x+1)(x-1)$。",
        "solution": "先得 $4x^2-4x+1$ 与 $x^2-1$。第二项整体取负，得到 $3x^2-4x+2$。"
      }
    ],
    "error": "把 $(a-b)^2$ 的中间项写成 $-ab$，漏掉一次交叉相乘。写出 $a(-b)+(-b)a$ 即可核对。",
    "standard": "能独立列齐乘积，正确合并同类项，并用代入检查常数与符号。",
    "application": "函数差值比较中先展开，再提取共同因式来判号。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
