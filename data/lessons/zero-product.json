    "methods": [
      "factor-route"
    ],
    "problemTypes": [
      "root-problem"
    ],
    "foundation": "实数乘积为零当且仅当至少一个因子为零。先把右端移到零，再选分解方式。",
    "principle": "若 $ab=0$ 且 $a\\ne0$，两边除以 $a$ 得 $b=0$；若 $a=0$，乘积本来为零。",
    "approach": "有公因式就先提取；整系数二次式明显可分解时优先用此法。分解困难时用公式法。",
    "examples": [
      {
        "level": "入门",
        "prompt": "解 $x^2=5x$。",
        "solution": "移项并分解为 $x(x-5)=0$，得 $x=0$ 或 $x=5$。"
      },
      {
        "level": "进阶",
        "prompt": "解 $x(x+2)=8$。",
        "solution": "先移项得 $x^2+2x-8=0$，分解成 $(x+4)(x-2)=0$，得到 $-4,2$。"
      }
    ],
    "error": "两边直接除以 $x$ 会丢掉零根。先把式子写成零乘积。",
    "standard": "能从原式列全解集，解释移项与取零因子为什么不引入多余根。",
    "application": "函数交点问题可通过比较表达式并求差的零点解决。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
