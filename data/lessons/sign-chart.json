  "lesson": {
    "definition": "确定二次式的零点和各区间符号，再选出解集。",
    "prerequisites": [
      "factor",
      "formula"
    ],
    "knowledge": [
      "zeros",
      "delta"
    ],
    "methods": [
      "sign-route",
      "square-route"
    ],
    "problemTypes": [
      "sign-problem"
    ],
    "foundation": "不同实根切分数轴；首项系数决定两端同号。严格不等式排除零点。",
    "principle": "若 $a(x-r_1)(x-r_2)$ 中 $r_1<r_2$，中间两个因子异号，外侧两个因子同号。重根对应平方，经过它时符号不改变。",
    "approach": "先把右边变成 0。可分解时用符号表；无实根或有重根时可配方确认全局符号。",
    "examples": [
      {
        "level": "入门",
        "prompt": "解 $x^2-x-6<0$。",
        "solution": "分解为 $(x-3)(x+2)$，仅在 $-2<x<3$ 时异号。"
      },
      {
        "level": "进阶",
        "prompt": "解 $-2(x-1)^2\\ge0$。",
        "solution": "整个式子始终非正，只有 $x=1$ 时为 0，所以解集是 $\\{1\\}$。"
      }
    ],
    "error": "记住「大于取两边」却忽略首项系数。先验两端符号，再读要求。",
    "standard": "能处理首项正负、无实根或重根，以及严格和非严格端点。",
    "application": "在求函数定义域、比较函数值及讨论参数时，不等式常承担最后的取值筛选。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
