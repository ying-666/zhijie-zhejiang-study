  "lesson": {
    "definition": "把指数式改写为同底或同一个指数变量，以便应用运算和单调性。",
    "prerequisites": [],
    "knowledge": [
      "powers"
    ],
    "methods": [
      "same-base"
    ],
    "problemTypes": [
      "root-problem"
    ],
    "foundation": "在 $a>0$ 时，$a^u a^v=a^{u+v}$，$(a^u)^v=a^{uv}$。比较大小时还需知道底数与 1 的关系。",
    "principle": "整数指数的乘法来自相同因子的拼接；负指数由保持 $a^u a^{-u}=a^0=1$ 定义。对同底指数方程，$a>0,a\\ne1$ 时单调性保证指数相等。",
    "approach": "可轻松统一底数时直接改写。出现 $a^{2x},a^x$ 的多项式时，令 $t=a^x>0$，解后恢复 $x$。",
    "examples": [
      {
        "level": "入门",
        "prompt": "解 $4^x=2^{x+3}$。",
        "solution": "写成 $2^{2x}=2^{x+3}$，故 $2x=x+3$，得 $x=3$。"
      },
      {
        "level": "进阶",
        "prompt": "解 $4^x-3\\cdot2^x+2=0$。",
        "solution": "令 $t=2^x>0$，得 $(t-1)(t-2)=0$，对应 $x=0,1$。"
      }
    ],
    "error": "把 $a^u+a^v$ 按指数相加。指数相加只对应同底相乘。",
    "standard": "能选择统一的底数、处理乘方与积，并在换元后检查正性。",
    "application": "指数函数交点和比较题常先统一底数，再用单调性或换元。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
