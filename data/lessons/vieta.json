    "subject": "math",
    "name": "根与系数关系",
    "parent": "quadratic",
    "definition": "在实根存在的前提下，提取两根的和、积并处理对称式。"
  },
  "lesson": {
    "definition": "在实根存在的前提下，提取两根的和、积并处理对称式。",
    "prerequisites": [
      "formula"
    ],
    "knowledge": [
      "zeros",
      "delta"
    ],
    "methods": [
      "vieta-route"
    ],
    "problemTypes": [
      "root-problem",
      "parameter-problem"
    ],
    "foundation": "对 $ax^2+bx+c=0$ 的两根 $u,v$（可相等），有 $u+v=-b/a$、$uv=c/a$。",
    "principle": "因 $a(x-u)(x-v)=ax^2-a(u+v)x+auv$，比较系数得到关系。",
    "approach": "题目要求对称量时先写成和、积；指定某个根或比较根的位置时需要额外信息。",
    "examples": [
      {
        "level": "入门",
        "prompt": "求 $2x^2-5x+1=0$ 的两根之和和积。",
        "solution": "$\\Delta=17>0$。和为 $5/2$，积为 $1/2$。"
      },
      {
        "level": "进阶",
        "prompt": "求 $x^2-3x-2=0$ 的两根平方和。",
        "solution": "$\\Delta=17>0$。平方和为 $(u+v)^2-2uv=9+4=13$。"
      }
    ],
    "error": "只算根的和积就断定实根存在。先检查题干是否已给实根，否则先验判别式。",
    "standard": "能为一个对称根表达式写出等价形式，并保留求倒数所需的非零条件。",
    "application": "含参根关系题可用和积改写约束，再验判别式和规定的根序。",
    "source": "AI 辅助原创",
    "review": "待教师复审"
  },
